<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>BlytSharp</RootNamespace>
    <AssemblyName>BlytSharp</AssemblyName>
    <Version>1.0.0</Version>
    <Authors>Aiden A</Authors>
    <Description>Readers for Nintendo Ui2D layout formats (BFLYT, BFLAN, BFLIM, BFFNT) in their Cafe and NX variants.</Description>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
  </PropertyGroup>

</Project>
